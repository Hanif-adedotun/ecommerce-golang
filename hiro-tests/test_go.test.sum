package db

import (
	"database/sql"
	"errors"
	"testing"
)

func TestConnectDB(t *testing.T) {
	// Arrange
	type args struct {
		databaseURL string
	}
	tests := []struct {
		name       string
		args       args
		wantErr bool
	} {
		{
			name: "Valid database connection",
			args: args{
				databaseURL: "host=localhost user=myuser password=mypassword port=5432 database=mydatabase",
			},
			wantErr: false,
		}, {
			name: "Invalid database connection",
			args: args{
				databaseURL: " host=localhost user=myuser password=mypassword port=5432 database=mydatabase2",
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Act
			db, err := ConnectDB()

			// Assert
			if (err != nil) != tt.wantErr {
				t.Errorf("ConnectDB() error = %v, wantErr %v", err, tt.wantErr)
			}

			// Close the database connection
			if db != nil {
				defer db.Close()
			}
		})
	}
}
